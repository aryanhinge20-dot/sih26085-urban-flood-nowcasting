# Copy to .env and fill in real values. .env is git-ignored -- never commit credentials.
# See docs/LIVE_RAINFALL_AUDIT.md for how/whether to obtain these.

# IMD API Management Platform (https://api.imd.gov.in) API key.
# Obtaining one is NOT self-service: requires organisational registration on the portal AND, per IMD's own
# documentation, contacting the Nodal Officer (Dr. Sankar Nath, IMD New Delhi, sankar.nath@imd.gov.in) to be
# granted access under IMD's terms and conditions -- expect a manual approval process, not instant issuance.
# Leave unset/blank to run without live IMD data: IMDObservationProvider then reports itself as
# unavailable (reason: "not configured") rather than silently substituting fake data.
IMD_API_KEY=

# IMD station id for the current-weather endpoint (current_wx). Default 43003 = Mumbai-Santacruz, verified
# against IMD's own city.imd.gov.in linking convention (city.imd.gov.in/citywx/...?id=43003) -- see the audit
# doc. Override only if you have verified a different, more appropriate station id.
IMD_STATION_ID=43003



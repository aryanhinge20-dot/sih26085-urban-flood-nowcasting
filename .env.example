# Copy to .env (repo root) and fill in real values. .env is git-ignored -- never commit credentials.
# Names only: no real value ever belongs in this file. Deployment notes: docs/DEPLOYMENT.md.

# ── Backend (server-side ONLY — never expose these to the browser, never prefix them with VITE_) ─────────────

# IMD API Management Platform (https://api.imd.gov.in). BOTH are required and they are different values:
#   IMD_API_KEY   -> sent as X-API-Key. The key is bound to ONE public IP; a deployed server needs a key
#                    generated for ITS static outbound IP.
#   IMD_API_TOKEN -> sent as Authorization: Bearer. It EXPIRES (~1 h). Optional when IMD_EMAIL / IMD_PASSWORD are
#                    set: FloodNet then generates and renews it automatically (docs/IMD_TOKEN_RENEWAL.md).
IMD_API_KEY=
IMD_API_TOKEN=
# IMD portal account used for automatic token generation (POST https://api.imd.gov.in/api/oauth/token.php).
# Backend-only secrets, kept separate from IMD_API_KEY. Never commit, never prefix with VITE_.
IMD_EMAIL=
IMD_PASSWORD=
# Where the account credentials come from: env (default) | aws-secretsmanager | aws-ssm
IMD_CREDENTIALS_PROVIDER=
# aws-secretsmanager: secret holding JSON {"IMD_EMAIL": ..., "IMD_PASSWORD": ...}
IMD_CREDENTIALS_SECRET_ID=
# aws-ssm: SecureString parameter names
IMD_EMAIL_SSM_PARAMETER=
IMD_PASSWORD_SSM_PARAMETER=
# 0 disables the background token keeper (renewal at request time still runs). Default on.
FLOODNET_IMD_AUTO_RENEW=
# Optional, local development / non-Vercel hosts only: a file that holds ONLY the token (not needed with IMD_EMAIL/IMD_PASSWORD).
IMD_API_TOKEN_FILE=
# Assumed token lifetime in minutes, used only for the "expiring soon" estimate (IMD publishes none). Default 60.
IMD_TOKEN_TTL_MIN=
# Where the token comes from: env (default: IMD_API_TOKEN / .env, or IMD_API_TOKEN_FILE if set) | file |
# aws-secretsmanager | aws-ssm. It is re-read on every IMD request, so rotating it needs no restart or rebuild.
IMD_TOKEN_PROVIDER=
# aws-secretsmanager: secret id, and (if the secret is JSON) the key holding the token
IMD_TOKEN_SECRET_ID=
IMD_TOKEN_SECRET_KEY=
# aws-ssm: SecureString parameter name
IMD_TOKEN_SSM_PARAMETER=
# seconds a value read from AWS is reused before asking again (default 60)
IMD_TOKEN_CACHE_S=
# Enables POST /api/admin/imd-token (token rotation in the running server). Unset = the endpoint does not exist.
FLOODNET_ADMIN_TOKEN=

# IMD station for current_wx. Default 43003 = Mumbai-Santacruz (43057 = Mumbai-Colaba).
IMD_STATION_ID=43003

# Google Cloud Text-to-Speech for the Guided Briefing / Demo Story voice (en-IN, hi-IN, mr-IN). Optional:
# unset -> the browser's own voice is used, or the briefing runs silently; the UI says which.
GOOGLE_TTS_API_KEY=
# Speaking rate (default 0.95).
FLOODNET_TTS_RATE=
# Optional explicit voice names; each must belong to its language (e.g. mr-IN-Wavenet-A) or it is rejected.
FLOODNET_TTS_VOICE_EN=
FLOODNET_TTS_VOICE_HI=
FLOODNET_TTS_VOICE_MR=

# 1 = enable the experimental radar-image advection nowcast (default off; see docs/RADAR_NOWCAST_STATUS.md).
FLOODNET_RADAR_NOWCAST=

# Allowed browser origins when the frontend is hosted separately (comma-separated), e.g.
# https://floodnet.vercel.app . Unset = "*".
FLOODNET_CORS_ORIGINS=

# ── Frontend build (public values, baked into the JS bundle — NOT secrets) ───────────────────────────────
# Origin of the FloodNet API when the frontend is hosted separately (no trailing slash), e.g.
# https://floodnet-api.example.com . Unset = same origin (local FastAPI at /static, the Vite dev proxy, or the
# all-in-one Vercel deployment). LEAVE UNSET ON VERCEL: the API is served from the same origin there.
VITE_API_BASE_URL=
# Base path of the built site: "/" on a static host such as Vercel; unset = "/static/" (served by FastAPI).
VITE_BASE=

# ── Not needed to run FloodNet ───────────────────────────────────────────────────────────────────────────
# EARTHDATA_TOKEN   only for the optional, unverified GPM IMERG provider.
# IMD_RADAR_ENABLED leave unset. It belongs to the inert `imd_radar` boundary (IMD has no radar-product API);
#                   the working radar path is the experimental image-derived source `imd_sri`, which needs no
#                   credential -- see docs/RADAR_SRI_IMAGE.md.
